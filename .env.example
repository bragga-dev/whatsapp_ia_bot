############################################
# IA (MODELOS E PROMPT)
############################################

# Primeiro modelo responde; os seguintes são fallback
LLM_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=30
LLM_REASONING_EFFORT=low

GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Prompt para contextualização de perguntas
AI_CONTEXTUALIZE_PROMPT='Dado um histórico de conversa e a pergunta mais recente do usuário, que pode fazer referência ao contexto anterior, formule uma pergunta independente, que possa ser compreendida sem o histórico da conversa. NÃO responda à pergunta — apenas reformule se necessário; caso contrário, retorne a pergunta como está.'

# Prompt principal do sistema
AI_SYSTEM_PROMPT='Você é a assistente virtual da BRAGGA DEV, uma empresa especializada em desenvolvimento web e automações. Converse como uma pessoa atenciosa no chat: tom natural, simpático e direto, frases curtas, sem formalidade excessiva e sem listas longas; no máximo um emoji quando fizer sentido. Cumprimentos, agradecimentos e conversa casual: responda naturalmente, sem inventar nada. Para dúvidas sobre a empresa, seus serviços, preços, horários e prazos, use somente as informações de apoio fornecidas no contexto. Se a resposta não estiver disponível, diga com naturalidade que não tem essa informação e ofereça chamar um atendente humano. Nunca invente preços, prazos ou políticas. Nunca mencione documentos, contexto ou base de conhecimento. Se a pergunta estiver vaga, faça uma única pergunta para entender melhor. Responda sempre no idioma do cliente. {context}'


############################################
# TELEGRAM E ADMIN
############################################

TELEGRAM_BOT_TOKEN=
WELCOME_MESSAGE=Olá! Como posso ajudar?

# Chave dos endpoints /rag/ingest e /rag/reindex
ADMIN_API_KEY=


############################################
# CONFIGURAÇÃO DA EVOLUTION API (WHATSAPP)
############################################

EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_INSTANCE_NAME=braggadev
AUTHENTICATION_API_KEY=
CONFIG_SESSION_PHONE_VERSION=2.3000.1015901307


############################################
# BANCO DE DADOS (POSTGRESQL)
############################################

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://postgres:postgres@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange

DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true


############################################
# CACHE (REDIS)
############################################

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false


############################################
# RAG (RECUPERAÇÃO DE CONTEXTO)
############################################

VECTOR_STORE_PATH=vectorstore
RAG_FILES_DIR=rag_files

# Relevância mínima para utilizar documentos recuperados
RAG_MIN_SCORE=0.25
RAG_TOP_K=4

# Quantidade de mensagens anteriores utilizadas
HISTORY_MESSAGES=10


############################################
# BUFFER E CONTROLE DE MENSAGENS
############################################

BUFFER_KEY_SUFIX='_msg_buffer'
DEBOUNCE_SECONDS=2
BUFFER_TTL=300
```
